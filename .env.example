# Copy this file to .env.local and fill in your own Supabase project's values.
# Project Settings -> API in the Supabase dashboard has all three.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used server-side to verify the role claim embedded in a user's JWT
# (see src/lib/get-user-role.ts). Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=your-jwt-secret
