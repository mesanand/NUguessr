# Copy this file to .env.local and fill in your own Supabase project's values.
# Project Settings -> API in the Supabase dashboard has these.

# --- App (public; safe in the browser) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Photo pipeline scripts only (scripts/places/*) — NEVER prefix with NEXT_PUBLIC_
# The deployed app does not need these. The service-role key bypasses RLS:
# keep it in .env.local only, never in client code or the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Mapillary client token for `npm run places:fetch:mapillary`
# (free, https://www.mapillary.com/dashboard/developers).
MAPILLARY_TOKEN=
# Optional: credit line used for photos imported with `npm run places:fetch:own`.
OWN_PHOTO_AUTHOR=
